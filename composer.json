{
    "name": "igamov/filament-media-gallery",
    "description": "Spatie Media Library gallery field and column for Filament v5",
    "keywords": [
        "igamov",
        "laravel",
        "filament",
        "filament-media-gallery",
        "spatie",
        "media-library"
    ],
    "homepage": "https://github.com/igamov/filament-media-gallery",
    "support": {
        "issues": "https://github.com/igamov/filament-media-gallery/issues",
        "source": "https://github.com/igamov/filament-media-gallery"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "igamov",
            "email": "dev@igamov.ru",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2|^8.3",
        "filament/filament": "^5.0",
        "spatie/laravel-medialibrary": "^11.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "larastan/larastan": "^3.0",
        "nunomaduro/collision": "^8.1",
        "orchestra/testbench": "^9.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-arch": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Igamov\\FilamentMediaGallery\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Igamov\\FilamentMediaGallery\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "php -d memory_limit=512M vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Igamov\\FilamentMediaGallery\\FilamentMediaGalleryServiceProvider"
            ],
            "aliases": {
                "FilamentMediaGallery": "Igamov\\FilamentMediaGallery\\Facades\\FilamentMediaGallery"
            }
        },
        "branch-alias": {
            "dev-5.x": "2.0.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
